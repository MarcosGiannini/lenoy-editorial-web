---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/catalog', label: 'Catálogo' },
  { href: '/blog', label: 'Blog' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-cream-100/95 backdrop-blur-sm border-b border-cream-300">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Navegación principal">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 group" aria-label="Editorial Lenoy - Inicio">
        <div class="w-8 h-8 bg-terracotta-500 rounded-full flex items-center justify-center">
          <span class="text-white font-serif font-bold text-sm" aria-hidden="true">L</span>
        </div>
        <span class="font-serif font-semibold text-xl text-gray-900 group-hover:text-terracotta-500 transition-colors">
          Editorial Lenoy
        </span>
      </a>

      <ul class="hidden md:flex items-center gap-8" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={`font-medium text-sm transition-colors hover:text-terracotta-500 ${
                currentPath === href
                  ? 'text-terracotta-500 border-b-2 border-terracotta-500 pb-0.5'
                  : 'text-gray-600'
              }`}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href="/catalog"
        class="hidden md:inline-flex items-center px-4 py-2 bg-terracotta-500 text-white text-sm font-medium rounded-full hover:bg-terracotta-600 transition-colors focus:outline-none focus:ring-2 focus:ring-terracotta-500 focus:ring-offset-2"
      >
        Ver catálogo
      </a>

      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:text-terracotta-500 hover:bg-cream-200 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-cream-300 py-4"
      role="region"
      aria-label="Menú móvil"
    >
      <ul class="flex flex-col gap-1" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={`block px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                currentPath === href
                  ? 'bg-terracotta-50 text-terracotta-600'
                  : 'text-gray-600 hover:bg-cream-200 hover:text-gray-900'
              }`}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
        <li class="mt-2 px-3">
          <a
            href="/catalog"
            class="block text-center px-4 py-2 bg-terracotta-500 text-white text-sm font-medium rounded-full hover:bg-terracotta-600 transition-colors"
          >
            Ver catálogo
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
  });
</script>
