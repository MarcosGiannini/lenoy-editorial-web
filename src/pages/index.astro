---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { getCollection } from 'astro:content';

const allBooks = await getCollection('books');
const booksData = allBooks.map((b) => ({ id: b.id, ...b.data }));
const featuredBook = booksData.find((b) => b.featured);
const recentBooks = booksData.slice(0, 3);
---

<BaseLayout
  title="Inicio"
  description="Editorial Lenoy — Edición, difusión y preservación de literatura feminista y LGTBIQA+ y literaturas africanas en español."
>
  <!-- Hero Section -->
  <section
    class="relative min-h-[90vh] flex items-center overflow-hidden bg-cream-100 dark:bg-[#1a1510]"
    aria-labelledby="hero-heading"
  >
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute -top-20 -right-20 w-96 h-96 bg-terracotta-100 rounded-full opacity-50"></div>
      <div class="absolute bottom-0 -left-20 w-80 h-80 bg-forest-100 rounded-full opacity-40"></div>
      <div class="absolute top-1/3 right-1/4 w-32 h-32 bg-sunset-100 rounded-full opacity-60"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid md:grid-cols-2 gap-12 items-center">
      <div data-reveal>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-terracotta-100 text-terracotta-600 text-sm font-medium rounded-full mb-6">
          <span class="w-1.5 h-1.5 bg-terracotta-500 rounded-full" aria-hidden="true"></span>
          Literaturas africanas en español &middot; Literatura que transforma
        </div>

        <h1 id="hero-heading" class="font-serif text-5xl sm:text-6xl font-bold text-gray-900 dark:text-cream-100 leading-tight mb-6">
          Literatura que<br />
          <em class="text-terracotta-500 not-italic">libera</em> y<br />
          <em class="text-forest-700 not-italic">transforma</em>
        </h1>

        <p class="text-lg text-gray-600 dark:text-cream-300 leading-relaxed mb-8 max-w-lg">
          Edición, difusión y preservación de literatura feminista y LGTBIQA+. Voces auténticas que merecen ser escuchadas.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="/publicaciones"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-terracotta-500 text-white font-medium rounded-full hover:bg-terracotta-600 transition-colors focus:outline-none focus:ring-2 focus:ring-terracotta-500 focus:ring-offset-2"
          >
            Descubrir las publicaciones
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/blog"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-forest-700 dark:border-forest-400 text-forest-700 dark:text-forest-400 font-medium rounded-full hover:bg-forest-50 dark:hover:bg-forest-900/30 transition-colors focus:outline-none focus:ring-2 focus:ring-forest-700 focus:ring-offset-2 dark:focus:ring-offset-[#1a1510]"
          >
            Leer el blog
          </a>
        </div>
      </div>

      {featuredBook && (
        <div data-reveal style="--reveal-delay: 120ms" class="relative flex justify-center">
          <div class="relative w-64 transform rotate-2 hover:rotate-0 transition-transform duration-300">
            <div class="aspect-[2/3] bg-gradient-to-br from-terracotta-400 to-terracotta-600 rounded-lg shadow-2xl p-8 flex flex-col items-center justify-center text-center">
              <div class="w-16 h-0.5 bg-white/50 mb-6 rounded"></div>
              <h2 class="font-serif text-xl font-bold text-white leading-tight mb-4">
                {featuredBook.title}
              </h2>
              <div class="w-10 h-0.5 bg-white/40 mb-4 rounded"></div>
              <p class="text-terracotta-100 text-sm font-medium">{featuredBook.author}</p>
              <div class="mt-8 text-xs text-terracotta-200 uppercase tracking-widest">Editorial Lenoy</div>
            </div>
            <div class="absolute -bottom-4 -right-4 w-full h-full bg-terracotta-800/20 rounded-lg -z-10"></div>
          </div>

          <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 bg-sunset-500 text-white text-xs font-medium px-3 py-1.5 rounded-full shadow-md whitespace-nowrap">
            &#10022; Destacado del mes
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-20 bg-forest-700" aria-labelledby="mission-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-12">
        <h2 id="mission-heading" class="font-serif text-4xl font-bold text-cream-100 mb-4">
          Nuestra misión
        </h2>
        <div class="w-16 h-0.5 bg-terracotta-400 mx-auto"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div data-reveal class="text-center p-6">
          <div class="w-12 h-12 bg-terracotta-500 rounded-full flex items-center justify-center mx-auto mb-4" aria-hidden="true">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-cream-100 mb-3">Edición</h3>
          <p class="text-cream-300 leading-relaxed text-sm">
            Publicamos obras de autoras ecuatoguineanas con los más altos estándares editoriales, cuidando cada detalle desde el manuscrito hasta el libro terminado.
          </p>
        </div>

        <div data-reveal style="--reveal-delay: 80ms" class="text-center p-6">
          <div class="w-12 h-12 bg-sunset-500 rounded-full flex items-center justify-center mx-auto mb-4" aria-hidden="true">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-cream-100 mb-3">Difusión</h3>
          <p class="text-cream-300 leading-relaxed text-sm">
            Llevamos estas voces al mundo hispanohablante y más allá, construyendo puentes entre Guinea Ecuatorial y las comunidades lectoras globales.
          </p>
        </div>

        <div data-reveal style="--reveal-delay: 160ms" class="text-center p-6">
          <div class="w-12 h-12 bg-forest-400 rounded-full flex items-center justify-center mx-auto mb-4" aria-hidden="true">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-cream-100 mb-3">Preservación</h3>
          <p class="text-cream-300 leading-relaxed text-sm">
            Archivamos y preservamos el patrimonio literario feminista y LGTB ecuatoguineano para que las generaciones futuras puedan acceder a estas historias esenciales.
          </p>
        </div>
      </div>

      <div data-reveal class="mt-12 text-center max-w-2xl mx-auto">
        <blockquote class="font-serif text-xl italic text-cream-200 leading-relaxed">
          &ldquo;Edición, difusión y preservación de literatura feminista y LGTB de Guinea Ecuatorial.&rdquo;
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Featured Books Section -->
  <section class="py-20 bg-cream-100 dark:bg-[#1a1510]" aria-labelledby="featured-books-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="flex items-end justify-between mb-10">
        <div>
          <h2 id="featured-books-heading" class="font-serif text-4xl font-bold text-gray-900 dark:text-cream-100 mb-2">
            Novedades editoriales
          </h2>
          <div class="w-16 h-0.5 bg-terracotta-400"></div>
        </div>
        <a
          href="/publicaciones"
          class="text-sm font-medium text-terracotta-500 hover:text-terracotta-600 transition-colors flex items-center gap-1 group"
        >
          Ver todas las publicaciones
          <svg
            class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentBooks.map((book, index) => (
          <BookCard book={book} revealDelay={`${index * 80}ms`} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-terracotta-500" aria-labelledby="cta-heading">
    <div data-reveal class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="cta-heading" class="font-serif text-3xl font-bold text-white mb-4">
        &iquest;Quieres colaborar con nosotras?
      </h2>
      <p class="text-terracotta-100 mb-8 leading-relaxed">
        Trabajamos con autoras, ONGs y organizaciones comprometidas con la igualdad y la diversidad en Guinea Ecuatorial. Escríbenos.
      </p>
      <a
        href="mailto:hola@editoriallenoy.com"
        class="inline-flex items-center gap-2 px-6 py-3 bg-white text-terracotta-500 font-medium rounded-full hover:bg-cream-100 transition-colors focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-terracotta-500"
      >
        Contactar
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
