---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Qué es Lenoy"
  description="Conoce la historia, los objetivos, la trayectoria y el equipo de Editorial Lenoy, la editorial de literatura feminista y LGTB+ de Guinea Ecuatorial."
>
  <section class="bg-forest-700 py-16 px-4" aria-labelledby="que-es-lenoy-heading">
    <div class="max-w-6xl mx-auto text-center">
      <p class="text-terracotta-300 font-medium text-sm uppercase tracking-widest mb-4">La asociación</p>
      <h1 id="que-es-lenoy-heading" class="font-serif text-5xl font-bold text-cream-100 mb-6">
        Qué es Lenoy
      </h1>
      <p class="text-cream-300 max-w-2xl mx-auto leading-relaxed text-lg">
        Una asociación cultural. Un acto de resistencia. Una editorial nacida del amor por la literatura y por Guinea Ecuatorial.
      </p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
      <div class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-gray-900">Quiénes somos</h2>
        <p class="text-gray-600 leading-relaxed">[PENDIENTE: texto de Andrea sobre la historia de la asociación y por qué fundaron Lenoy]</p>
      </div>
      <div class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-gray-900">Objetivos</h2>
        <p class="text-gray-600 leading-relaxed">[PENDIENTE: texto de Andrea sobre los objetivos de la editorial]</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
      <div class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-gray-900">Trayectoria</h2>
        <p class="text-gray-600 leading-relaxed">[PENDIENTE: hitos de la editorial desde su fundación]</p>
      </div>
      <div class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-gray-900">Estatutos</h2>
        <p class="text-gray-600 leading-relaxed">[PENDIENTE: enlace al PDF de estatutos de la asociación]</p>
      </div>
    </div>

    <div class="space-y-6">
      <h2 class="font-serif text-2xl font-bold text-gray-900">El equipo</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-cream-100 rounded-2xl p-6 border border-cream-300">
          <div class="w-16 h-16 bg-terracotta-100 rounded-full flex items-center justify-center mb-4">
            <span class="font-serif font-bold text-terracotta-500 text-2xl">A</span>
          </div>
          <h3 class="font-serif text-xl font-semibold text-gray-900 mb-1">Andrea Ramos</h3>
          <p class="text-sm text-terracotta-600 font-medium mb-3">Co-fundadora · Correctora y maquetadora</p>
          <p class="text-gray-600 text-sm leading-relaxed">[PENDIENTE: bio de Andrea]</p>
        </div>
        <div class="bg-cream-100 rounded-2xl p-6 border border-cream-300">
          <div class="w-16 h-16 bg-forest-100 rounded-full flex items-center justify-center mb-4">
            <span class="font-serif font-bold text-forest-700 text-2xl">M</span>
          </div>
          <h3 class="font-serif text-xl font-semibold text-gray-900 mb-1">Trifonia Melibea Obono</h3>
          <p class="text-sm text-forest-600 font-medium mb-3">Co-fundadora · Escritora y activista</p>
          <p class="text-gray-600 text-sm leading-relaxed">[PENDIENTE: bio de Melibea]</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
