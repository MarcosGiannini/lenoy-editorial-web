---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allAuthors = await getCollection('authors');

// Solo los dos miembros del equipo, Melibea siempre primera
const TEAM_ORDER = ['trifonia-melibea-obono', 'andrea-ramos'];
const team = TEAM_ORDER
  .map((id) => allAuthors.find((a) => a.id === id))
  .filter(Boolean);

const teamRoles: Record<string, string> = {
  'trifonia-melibea-obono': 'Co-fundadora · Escritora y activista',
  'andrea-ramos': 'Co-fundadora · Correctora y editora',
};
---

<BaseLayout
  title="Qué es Lenoy"
  description="Conoce la historia, los objetivos, la trayectoria y el equipo de Editorial Lenoy, la editorial de literatura feminista y LGTBIQA+ y literaturas africanas en español."
>
  <section class="bg-forest-700 py-16 px-4" aria-labelledby="que-es-lenoy-heading">
    <div data-reveal class="max-w-6xl mx-auto text-center">
      <div class="h-1 w-32 rounded-full flex overflow-hidden mx-auto mb-6" aria-hidden="true">
        <span class="flex-1 bg-red-400"></span>
        <span class="flex-1 bg-yellow-300"></span>
        <span class="flex-1 bg-green-400"></span>
        <span class="flex-1 bg-blue-400"></span>
        <span class="flex-1 bg-violet-500"></span>
      </div>
      <p class="text-terracotta-300 font-medium text-sm uppercase tracking-widest mb-4">La asociación</p>
      <h1 id="que-es-lenoy-heading" class="font-serif text-5xl font-bold text-cream-100 mb-6">
        Qué es Lenoy
      </h1>
      <p class="text-cream-300 max-w-2xl mx-auto leading-relaxed text-lg">
        Una asociación cultural. Un acto de resistencia. Una editorial nacida del amor por la literatura y por las literaturas africanas en español.
      </p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
      <div data-reveal class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-gray-900 dark:text-cream-100">Quiénes somos</h2>
        <p class="text-gray-600 dark:text-cream-300 leading-relaxed">Asociación Cultural Lenoy es un proyecto cultural, principalmente editorial (aunque no solo) con impacto social. Trabajamos para visibilizar voces diversas, generar memoria cultural y fortalecer los vínculos entre África y el ámbito hispanohablante.</p>
        <p class="text-gray-600 dark:text-cream-300 leading-relaxed">Nació en 2023 con el objetivo de promover, editar y difundir literatura feminista y LGTBIQA+ de minorías sexuales y de origen afro, un ámbito aún poco representado en el panorama editorial en lengua española.</p>
      </div>
      <div data-reveal style="--reveal-delay: 80ms" class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-gray-900 dark:text-cream-100">Objetivos</h2>
        <p class="text-gray-600 dark:text-cream-300 leading-relaxed">Rescatar voces, acompañar procesos creativos y generar espacios de circulación cultural que conecten autoras y autores con nuevas audiencias. Desarrollamos proyectos editoriales en colaboración con organizaciones sociales y culturales, fomentando la diversidad, la inclusión y la memoria literaria.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
      <div data-reveal class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-gray-900 dark:text-cream-100">Trayectoria</h2>
        <p class="text-gray-600 dark:text-cream-300 leading-relaxed">Asociación creada en 2023 e inscrita en el Registro Nacional de Asociaciones con el número 626591. Hemos desarrollado proyectos editoriales en colaboración con entidades sociales, promoviendo la inclusión y la representación de voces feministas y LGTBIQA+.</p>
      </div>
      <div data-reveal style="--reveal-delay: 80ms" class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-gray-900 dark:text-cream-100">Estatutos</h2>
        <p class="text-gray-600 dark:text-cream-300 leading-relaxed">[PENDIENTE: enlace al PDF de estatutos de la asociación]</p>
      </div>
    </div>

    <section data-reveal class="mb-16 overflow-hidden rounded-2xl border border-cream-300 dark:border-gray-700 bg-cream-100 dark:bg-gray-800" aria-labelledby="compromiso-heading">
      <div class="h-1 flex" aria-hidden="true">
        <span class="flex-1 bg-red-400"></span>
        <span class="flex-1 bg-yellow-300"></span>
        <span class="flex-1 bg-green-400"></span>
        <span class="flex-1 bg-blue-400"></span>
        <span class="flex-1 bg-violet-500"></span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-5 p-6 md:p-8">
        <div class="w-14 h-14 rounded-full bg-terracotta-100 dark:bg-terracotta-900/40 text-terracotta-600 dark:text-terracotta-200 flex items-center justify-center font-serif text-3xl" aria-hidden="true">
          ♀
        </div>
        <div class="space-y-3">
          <p class="text-sm font-semibold uppercase tracking-widest text-terracotta-600 dark:text-terracotta-300">Compromiso</p>
          <h2 id="compromiso-heading" class="font-serif text-2xl font-bold text-gray-900 dark:text-cream-100">
            Literatura feminista, LGTBIQA+ y afroguineana
          </h2>
          <p class="text-gray-600 dark:text-cream-300 leading-relaxed">
            Nuestro trabajo se centra en las voces literarias feministas y LGTBIQA+. Si escribes sobre feminismos, Lenoy es tu casa. Si escribes para reivindicar los derechos humanos de las personas LGTBIQA+ negras, Lenoy es tu casa.
          </p>
        </div>
      </div>
    </section>

    <div data-reveal class="space-y-6">
      <h2 class="font-serif text-2xl font-bold text-gray-900 dark:text-cream-100">El equipo</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {team.map((member, i) => (
          <div data-reveal style={i > 0 ? '--reveal-delay: 80ms' : ''} class="bg-cream-100 dark:bg-gray-800 rounded-2xl p-6 border border-cream-300 dark:border-gray-700">
            {member.data.photo ? (
              <img
                src={member.data.photo}
                alt={`Foto de ${member.data.name}`}
                class="w-16 h-16 rounded-full object-cover mb-4"
              />
            ) : (
              <div class="w-16 h-16 bg-terracotta-100 dark:bg-terracotta-900/40 rounded-full flex items-center justify-center mb-4">
                <span class="font-serif font-bold text-terracotta-500 dark:text-terracotta-300 text-2xl">
                  {member.data.name.charAt(0)}
                </span>
              </div>
            )}
            <h3 class="font-serif text-xl font-semibold text-gray-900 dark:text-cream-100 mb-1">{member.data.name}</h3>
            <p class="text-sm text-terracotta-600 dark:text-terracotta-300 font-medium mb-3">{teamRoles[member.id]}</p>
            <p class="text-gray-600 dark:text-cream-300 text-sm leading-relaxed">{member.data.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
