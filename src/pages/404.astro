---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada — Editorial Lenoy"
  description="Esta página no existe, pero sí existen grandes libros. Vuelve al inicio o visita nuestro catálogo."
>
  <main class="min-h-[80vh] flex items-center justify-center px-4 py-20 relative overflow-hidden">

    <!-- Decoración de fondo (igual que el hero del home) -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-20 left-10 w-64 h-64 bg-terracotta-200 rounded-full opacity-20 blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-72 h-72 bg-forest-200 rounded-full opacity-15 blur-3xl"></div>
    </div>

    <div class="relative max-w-lg mx-auto text-center space-y-8">

      <!-- Número 404 grande decorativo -->
      <div aria-hidden="true" class="font-serif text-[8rem] leading-none font-bold text-terracotta-100 select-none">
        404
      </div>

      <!-- Icono de libro -->
      <div class="w-20 h-20 bg-forest-100 rounded-full flex items-center justify-center mx-auto -mt-8" aria-hidden="true">
        <svg class="w-10 h-10 text-forest-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>

      <div class="space-y-3">
        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-gray-900">
          Esta página no está en el catálogo
        </h1>
        <p class="text-gray-600 leading-relaxed text-lg">
          La URL que buscas no existe, pero hay mucho por descubrir en Editorial Lenoy.
        </p>
        <p class="text-gray-500 leading-relaxed text-sm">
          Quizás el enlace está mal escrito o la página se ha movido.
        </p>
      </div>

      <!-- Acciones -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/publicaciones"
          class="inline-flex items-center gap-2 px-6 py-3 bg-terracotta-500 text-white font-semibold rounded-full hover:bg-terracotta-600 transition-colors focus:outline-none focus:ring-2 focus:ring-terracotta-500 focus:ring-offset-2"
        >
          Ver publicaciones
        </a>
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 text-gray-700 font-semibold rounded-full hover:border-terracotta-400 hover:text-terracotta-500 transition-colors focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:ring-offset-2"
        >
          Volver al inicio
        </a>
      </div>

    </div>
  </main>
</BaseLayout>
