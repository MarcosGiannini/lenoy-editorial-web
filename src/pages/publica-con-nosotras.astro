---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Publica con nosotras"
  description="¿Tienes una obra que quieres publicar? Envíanos tu propuesta. Publicamos literatura feminista y LGTBIQA+ con perspectiva afroguineana y literaturas africanas en español."
>
  <section class="bg-forest-700 py-16 px-4" aria-labelledby="publica-heading">
    <div data-reveal class="max-w-6xl mx-auto text-center">
      <div class="h-1 w-32 rounded-full flex overflow-hidden mx-auto mb-6" aria-hidden="true">
        <span class="flex-1 bg-red-400"></span>
        <span class="flex-1 bg-yellow-300"></span>
        <span class="flex-1 bg-green-400"></span>
        <span class="flex-1 bg-blue-400"></span>
        <span class="flex-1 bg-violet-500"></span>
      </div>
      <p class="text-forest-300 font-medium text-sm uppercase tracking-widest mb-4">Convocatoria abierta</p>
      <h1 id="publica-heading" class="font-serif text-5xl font-bold text-cream-100 mb-6">
        Publica con nosotras
      </h1>
      <p class="text-cream-300 max-w-2xl mx-auto leading-relaxed text-lg">
        Si tu obra tiene algo que decir desde una mirada feminista, LGTBIQA+ o afroguineana, queremos leerla.
      </p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 py-20">
    <div class="space-y-16">
      <div data-reveal class="bg-cream-100 dark:bg-gray-800 rounded-2xl p-8 space-y-6">
        <h2 class="font-serif text-2xl font-bold text-gray-900 dark:text-cream-100">Envíanos tu propuesta</h2>
        <form
          name="propuesta-editorial"
          method="POST"
          action="/gracias"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-4"
          aria-label="Formulario de propuesta editorial"
          novalidate
        >
          <!-- Campos ocultos requeridos por Netlify Forms -->
          <input type="hidden" name="form-name" value="propuesta-editorial" />
          <!-- Campo honeypot anti-spam: Netlify descarta el envío si viene relleno -->
          <p class="hidden" aria-hidden="true">
            <label>No rellenar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="nombre" class="block text-sm font-medium text-gray-700 dark:text-cream-300 mb-1">Nombre *</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                autocomplete="given-name"
                class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-cream-100 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta-400"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 dark:text-cream-300 mb-1">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-cream-100 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta-400"
              />
            </div>
          </div>

          <div>
            <label for="titulo" class="block text-sm font-medium text-gray-700 dark:text-cream-300 mb-1">Título de la obra *</label>
            <input
              type="text"
              id="titulo"
              name="titulo"
              required
              class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-cream-100 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta-400"
            />
          </div>

          <div>
            <label for="sinopsis" class="block text-sm font-medium text-gray-700 dark:text-cream-300 mb-1">Sinopsis breve *</label>
            <textarea
              id="sinopsis"
              name="sinopsis"
              rows="5"
              required
              class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-cream-100 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta-400 resize-y"
              placeholder="Máximo 300 palabras"
            ></textarea>
          </div>

          <div>
            <label for="manuscrito" class="block text-sm font-medium text-gray-700 dark:text-cream-300 mb-1">Adjuntar manuscrito (opcional)</label>
            <input
              type="file"
              id="manuscrito"
              name="manuscrito"
              accept=".pdf,.doc,.docx"
              aria-describedby="manuscrito-ayuda"
              class="w-full text-sm text-gray-600 dark:text-cream-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-medium file:bg-terracotta-100 file:text-terracotta-600 hover:file:bg-terracotta-200 dark:file:bg-terracotta-900/40 dark:file:text-terracotta-300 cursor-pointer"
            />
            <p id="manuscrito-ayuda" class="text-xs text-gray-400 dark:text-cream-500 mt-1">Formatos aceptados: PDF, DOC, DOCX</p>
            <!-- Netlify Forms no procesa file inputs nativamente -->
            <p class="text-xs text-amber-600 dark:text-amber-400 mt-1">
              ⚠️ Si el formulario no adjunta el archivo correctamente, envíalo directamente a <a href="mailto:hola@lenoyediciones.com" class="underline">hola@lenoyediciones.com</a>.
            </p>
          </div>

          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="privacidad"
              name="privacidad"
              required
              class="mt-1 h-4 w-4 rounded border-gray-300 text-terracotta-500 focus:ring-terracotta-400"
            />
            <label for="privacidad" class="text-sm text-gray-600 dark:text-cream-400">
              He leído y acepto la <a href="/que-es-lenoy#privacidad" class="text-terracotta-500 underline hover:text-terracotta-700">política de privacidad</a> * [PENDIENTE: añadir enlace real cuando se redacte el aviso legal]
            </label>
          </div>

          <button
            type="submit"
            class="bg-terracotta-500 text-white px-8 py-3 rounded-full font-semibold hover:bg-terracotta-600 transition-colors focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:ring-offset-2"
          >
            Enviar propuesta
          </button>
          <p class="text-sm text-gray-500 dark:text-cream-400 text-center">
            Nos pondremos en contacto contigo si la obra nos resulta interesante :-)
          </p>
        </form>
      </div>
    </div>
  </main>
</BaseLayout>
