---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { getBooksByCategory } from '../../data/books';
import { authors } from '../../data/authors';

const obrasPropias = getBooksByCategory('obras-propias');
const colaboracionOngs = getBooksByCategory('colaboracion-ongs');
---

<BaseLayout
  title="Catálogo"
  description="Descubre todas las publicaciones de Editorial Lenoy: obras propias y colaboraciones con ONGs de literatura feminista y LGTB de Guinea Ecuatorial."
>
  <section class="bg-forest-700 py-16 px-4" aria-labelledby="catalog-heading">
    <div class="max-w-6xl mx-auto text-center">
      <h1 id="catalog-heading" class="font-serif text-5xl font-bold text-cream-100 mb-4">
        Catálogo editorial
      </h1>
      <p class="text-cream-300 max-w-xl mx-auto leading-relaxed">
        Toda nuestra producción literaria: obras propias y proyectos en colaboración con organizaciones comprometidas con los derechos de las mujeres y la comunidad LGTB+ en Guinea Ecuatorial.
      </p>
    </div>
  </section>

  <section id="obras-propias" class="py-16 px-4" aria-labelledby="obras-propias-heading">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div>
          <h2 id="obras-propias-heading" class="font-serif text-3xl font-bold text-gray-900 mb-1">
            Obras propias
          </h2>
          <p class="text-gray-500 text-sm">Publicaciones originales de Editorial Lenoy</p>
        </div>
        <div class="flex-1 h-px bg-cream-300 ml-4" aria-hidden="true"></div>
        <span class="text-sm text-gray-400 whitespace-nowrap">
          {obrasPropias.length} {obrasPropias.length === 1 ? 'título' : 'títulos'}
        </span>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {obrasPropias.map((book) => (
          <BookCard book={book} />
        ))}
      </div>
    </div>
  </section>

  <section id="colaboracion-ongs" class="py-16 px-4 bg-cream-200" aria-labelledby="colaboracion-heading">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div>
          <h2 id="colaboracion-heading" class="font-serif text-3xl font-bold text-gray-900 mb-1">
            Colaboración con ONGs
          </h2>
          <p class="text-gray-500 text-sm">Proyectos editoriales con organizaciones de derechos humanos</p>
        </div>
        <div class="flex-1 h-px bg-cream-300 ml-4" aria-hidden="true"></div>
        <span class="text-sm text-gray-400 whitespace-nowrap">
          {colaboracionOngs.length} {colaboracionOngs.length === 1 ? 'título' : 'títulos'}
        </span>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {colaboracionOngs.map((book) => (
          <BookCard book={book} />
        ))}
      </div>
    </div>
  </section>

  <section id="autoras" class="py-16 px-4" aria-labelledby="authors-heading">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div>
          <h2 id="authors-heading" class="font-serif text-3xl font-bold text-gray-900 mb-1">
            Nuestras autoras
          </h2>
          <p class="text-gray-500 text-sm">Las voces detrás de nuestros libros</p>
        </div>
        <div class="flex-1 h-px bg-cream-300 ml-4" aria-hidden="true"></div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {authors.map((author) => (
          <AuthorCard author={author} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
