---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { socialLinks } from '../config/site';

const allBooks = await getCollection('books');
const books = allBooks.map((b) => ({ id: b.id, ...b.data }));
---

<BaseLayout
  title="Dónde comprar nuestros libros"
  description="Adquiere las publicaciones de Editorial Lenoy. Envío a toda España. Próximamente disponible online con pago seguro."
>
  <section class="bg-terracotta-500 py-16 px-4" aria-labelledby="comprar-heading">
    <div data-reveal class="max-w-6xl mx-auto text-center">
      <p class="text-terracotta-100 font-medium text-sm uppercase tracking-widest mb-4">Adquiere nuestras obras</p>
      <h1 id="comprar-heading" class="font-serif text-5xl font-bold text-white mb-6">
        Dónde comprar
      </h1>
      <p class="text-terracotta-100 max-w-2xl mx-auto leading-relaxed text-lg">
        Pronto podrás comprar directamente aquí. Mientras tanto, contacta con nosotras.
      </p>
    </div>
  </section>

  <main class="max-w-6xl mx-auto px-4 py-20">
    <div class="space-y-16">
      <!-- Listado de libros con precio (botones pendientes de Stripe) -->
      <section aria-labelledby="libros-heading">
        <h2 data-reveal id="libros-heading" class="font-serif text-3xl font-bold text-gray-900 dark:text-cream-100 mb-8">Nuestras publicaciones</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" role="list">
          {books.map((book, index) => (
            <li data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms`} class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 flex flex-col gap-4">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-serif text-lg font-semibold text-gray-900 dark:text-cream-100 leading-snug">{book.title}</h3>
                <p class="text-terracotta-500 font-bold text-lg flex-shrink-0">[PENDIENTE]&nbsp;€</p>
              </div>
              <p class="text-gray-500 dark:text-cream-400 text-sm">{book.author}</p>
              <p class="text-gray-600 text-sm leading-relaxed line-clamp-3">{book.description}</p>
              <!-- Botón de compra: deshabilitado hasta configurar Stripe Payment Links -->
              <button
                type="button"
                disabled
                aria-disabled="true"
                title="Próximamente disponible"
                class="mt-auto w-full bg-terracotta-200 text-terracotta-400 px-4 py-2 rounded-full text-sm font-semibold cursor-not-allowed opacity-70"
              >
                Comprar — Próximamente
              </button>
            </li>
          ))}
        </ul>
      </section>

      <!-- Info de envío -->
      <section data-reveal class="bg-cream-100 dark:bg-gray-800 rounded-2xl p-8 grid grid-cols-1 md:grid-cols-2 gap-8" aria-labelledby="envio-heading">
        <div>
          <h2 id="envio-heading" class="font-serif text-2xl font-bold text-gray-900 dark:text-cream-100 mb-4">Información de envío</h2>
          <ul class="space-y-2 text-gray-600 dark:text-cream-300 text-sm leading-relaxed">
            <li>📦 Envío a toda España peninsular e islas</li>
            <li>⏱ Plazo de entrega estimado: 3–5 días laborables</li>
            <li>💶 Gastos de envío: [PENDIENTE: tarifas de Andrea]</li>
            <li>🚚 Recogida en Madrid disponible bajo solicitud</li>
          </ul>
        </div>
        <div>
          <h3 class="font-serif text-xl font-bold text-gray-900 dark:text-cream-100 mb-4">Pedidos manuales</h3>
          <p class="text-gray-600 dark:text-cream-300 text-sm leading-relaxed mb-4">
            Mientras terminamos de configurar la tienda online, puedes hacer tu pedido por email, Instagram o Facebook.
          </p>
          <div class="flex flex-col gap-2">
            <a
              href="mailto:[PENDIENTE: email de Andrea]"
              class="inline-flex items-center gap-2 text-terracotta-500 font-medium text-sm hover:text-terracotta-700 transition-colors"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              [PENDIENTE: email]
            </a>
            <a
              href={socialLinks.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-terracotta-500 font-medium text-sm hover:text-terracotta-700 transition-colors"
              aria-label="Instagram de Editorial Lenoy"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
              </svg>
              Instagram @lenoy_ediciones
            </a>
            <a
              href={socialLinks.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-terracotta-500 font-medium text-sm hover:text-terracotta-700 transition-colors"
              aria-label="Facebook de Editorial Lenoy"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2V8.6H15.2c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.91h-2.34V22C18.34 21.24 22 17.08 22 12.06z" />
              </svg>
              Facebook Editorial Lenoy
            </a>
          </div>
        </div>
      </section>

      <!-- Enlace al blog "La ploma" -->
      <section data-reveal class="text-center" aria-labelledby="blog-heading">
        <h2 id="blog-heading" class="font-serif text-2xl font-bold text-gray-900 dark:text-cream-100 mb-4">La ploma +</h2>
        <p class="text-gray-600 dark:text-cream-300 max-w-xl mx-auto leading-relaxed mb-6">
          Nuestro espacio de reflexión sobre literatura, feminismo, Guinea Ecuatorial y LGTB+. Artículos, entrevistas y recomendaciones.
        </p>
        <a
          href="/blog"
          class="inline-block bg-forest-700 text-cream-100 px-8 py-3 rounded-full font-semibold hover:bg-forest-800 transition-colors focus:outline-none focus:ring-2 focus:ring-forest-600 focus:ring-offset-2"
        >
          Visitar La ploma +
        </a>
      </section>
    </div>
  </main>
</BaseLayout>
